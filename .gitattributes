# Git attributes for better diffs and merges

# Auto detect text files and normalize line endings
* text=auto

# Source code
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.jar binary

# Lockfiles
package-lock.json binary
yarn.lock binary
Gemfile.lock binary

# Generated files (merge=ours strategy)
android/app/build.gradle merge=ours
ios/Podfile.lock merge=ours
